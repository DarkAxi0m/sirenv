#!/bin/bash

# Ensure the script is run with root privileges for system cleanup.
if [[ $EUID -ne 0 ]]; then
    echo "Re-running the script with root privileges for complete system cleanup..."
    exec sudo "$0" "$@"
fi

SCRIPT_DIR="$(dirname "$(realpath "$0")")"
target_user="${SUDO_USER:-$USER}"
target_home="$(getent passwd "$target_user" | cut -d: -f6)"

run_user_script() {
    local script_path="$1"

    if [[ "$target_user" == "$USER" ]]; then
        "$script_path"
    else
        sudo -u "$target_user" "$script_path"
    fi
}

if [[ -n "$target_home" && -d "$target_home" ]]; then
    run_user_script "$SCRIPT_DIR/empty_trash.sh"
    run_user_script "$SCRIPT_DIR/sortage.sh"

    # Clear the invoking user's pip cache.
    if sudo -u "$target_user" command -v pip &>/dev/null; then
        echo "Purging user's pip cache..."
        sudo -u "$target_user" pip cache purge
    fi

    cache_dir="$target_home/.cache/pip"
    if [[ -d "$cache_dir" ]]; then
        echo "Manually clearing pip cache..."
        rm -rf "$cache_dir"
    fi
fi

echo "Calculating disk space before cleanup..."
before=$(df -h / | awk 'NR==2{print $4}')

# Continue with other system cleanup tasks
echo "Running Docker system prune..."
docker system prune -f

echo "Cleaning up APT cache..."
apt autoclean && apt autoremove -y

echo "Removing thumbnail cache..."
if [[ -n "$target_home" && -d "$target_home/.cache/thumbnails" ]]; then
    rm -rf "$target_home/.cache/thumbnails"/*
fi

# Uncomment the following line if you want to clean npm cache
# echo "Cleaning npm cache..."
# npm cache clean --force

echo "Uninstalling unused Flatpak packages..."
flatpak uninstall --unused -y

echo "Calculating disk space after cleanup..."
after=$(df -h / | awk 'NR==2{print $4}')

echo -e "Disk space before: $before\nDisk space after: $after"

if [[ -n "$target_home" && -d "$target_home/.cache/fontconfig" ]]; then
    echo "Cleaning fontconfig cache..."
    find "$target_home/.cache/fontconfig" -mindepth 1 -maxdepth 1 -type f -delete
    fc-cache -r -f
fi



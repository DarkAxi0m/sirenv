#!/bin/bash

echo "------------!-----------"
ip route get 8.8.8.8 2>/dev/null | awk '/src/ {for(i=1;i<=NF;i++) if($i=="src") print $(i+1)}'
if command -v dysk >/dev/null 2>&1; then
  dysk
else
  echo "------------!-----------"
  df -h -x tmpfs -x squashfs -x overlay -x fuse -x efivarfs | awk 'NR==1 || /^\/dev/'
  echo "------------!-----------"
fi


#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: lf [directory] [limit]

Find the largest files in a directory and its subdirectories.

Arguments:
  directory   Directory to scan. Defaults to current directory.
  limit       Number of files to show. Defaults to 10.

Examples:
  lf
  lf /var/log 25
USAGE
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

dir="${1:-.}"
limit="${2:-10}"

if [[ ! -d "$dir" ]]; then
  printf 'lf: not a directory: %s\n' "$dir" >&2
  exit 1
fi

if ! [[ "$limit" =~ ^[0-9]+$ ]] || [[ "$limit" -lt 1 ]]; then
  printf 'lf: limit must be a positive number\n' >&2
  exit 1
fi

tmp_file="$(mktemp)"
trap 'rm -f "$tmp_file"' EXIT

printf 'Counting files in %s...\n' "$dir" >&2
total_files="$(find "$dir" -type f 2>/dev/null | wc -l | tr -d ' ')"

if [[ "$total_files" == "0" ]]; then
  printf 'No files found in %s\n' "$dir"
  exit 0
fi

total_size="$(du -sb "$dir" 2>/dev/null | cut -f1)"
formatted_total_size="$(printf '%s\n' "$total_size" | numfmt --to=iec --suffix=B)"

printf 'Total directory size: %s\n' "$formatted_total_size"
printf 'Scanning %s files...\n' "$total_files" >&2

if command -v pv >/dev/null 2>&1; then
  find "$dir" -type f -print0 2>/dev/null \
    | pv -0 -l -s "$total_files" >/dev/null \
    | xargs -0 du -b 2>/dev/null >"$tmp_file" || true
else
  count=0
  while IFS= read -r -d '' file; do
    if size="$(du -b "$file" 2>/dev/null)"; then
      printf '%s\n' "$size" >>"$tmp_file"
    fi

    count=$((count + 1))
    if (( count % 100 == 0 || count == total_files )); then
      printf '\rProcessed %d/%d files' "$count" "$total_files" >&2
    fi
  done < <(find "$dir" -type f -print0 2>/dev/null)
  printf '\n' >&2
fi

if [[ ! -s "$tmp_file" ]]; then
  printf 'No readable files found in %s\n' "$dir"
  exit 0
fi

printf '\nLargest files in %s:\n' "$dir"
sort -rn "$tmp_file" \
  | head -n "$limit" \
  | numfmt --field=1 --to=iec --suffix=B --padding=8

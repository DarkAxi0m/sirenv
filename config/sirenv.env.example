#!/usr/bin/env bash

# Shared config for sirenv scripts.
# Replace the example values below with your own environment-specific settings.

export SRC_DIR="$HOME/Downloads/dwhelper"
export HOST_ADDR="your-host-or-ip"
export DEST_PATH="/path/to/remote/destination"
export REMOTE_USER="$USER"

# Stash integration for cleanup-files.sh
export STASH_URL="http://stash.example.com:9999"
export STASH_API_KEY=""
export STASH_SCAN_PATH="/path/to/remote/destination"
export STASH_SCAN_MODE="full"

# Matrix tooling
export MATRIX_URL="https://matrix.example.com"

# SMTP tooling
export SMTP_URL="smtp://smtp.example.com:25"

# Optional scan overrides for Stash.
# Leave these unset to let Stash use its own saved task defaults.
# Valid values: "true" or "false"
# export STASH_SCAN_RESCAN="false"
# export STASH_SCAN_GENERATE_COVERS="true"
# export STASH_SCAN_GENERATE_PREVIEWS="true"
# export STASH_SCAN_GENERATE_IMAGE_PREVIEWS="false"
# export STASH_SCAN_GENERATE_SPRITES="false"
# export STASH_SCAN_GENERATE_PHASHES="false"
# export STASH_SCAN_GENERATE_IMAGE_PHASHES="false"
# export STASH_SCAN_GENERATE_THUMBNAILS="false"
# export STASH_SCAN_GENERATE_CLIP_PREVIEWS="false"
